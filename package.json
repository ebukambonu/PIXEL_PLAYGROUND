    "lucide-react": "^0.468.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
