# Copy to .env locally. Never commit real passwords or the database.
PORT=3000
# Public HTTPS address for email verification links and secure cookies.
APP_URL=https://your-domain.example
# Recommended: HTTPS email delivery with Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Alternative: configure an SMTP provider to enable email verification and owner access.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: absolute path on a persistent volume. Default: ./data/pixel.db
# DATABASE_PATH=/persistent/pixel.db

# Render/Koyeb/Vercel deployment: store data in Turso instead of local ephemeral storage.
# Obtain the URL and token securely in your Turso account. Leave unset for local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set true on hosts without persistent local storage.
REQUIRE_REMOTE_DATABASE=false
# Free email option: Brevo, using a sender address you can verify.
# Set BREVO_API_KEY and EMAIL_FROM; Brevo takes priority over Resend when configured.
BREVO_API_KEY=

# Alternative remote storage: private Supabase transaction-pooler PostgreSQL URI.
# Takes priority over Turso. Never put this value in Google Sites or frontend code.
SUPABASE_DB_URL=
# Optional provider CA certificate, when needed; TLS verification is always enabled.
SUPABASE_CA_CERT=

# Supabase Edge deployment: use these custom secret names in the backend dashboard.
PIXEL_DATABASE_URL=
PIXEL_ADMIN_SETUP_KEY=
# Frontend public endpoint; no private key belongs here.
VITE_API_BASE_URL=
SUPABASE_URL=
# Private asset publishing credential, used only on a trusted build machine.
SUPABASE_SERVICE_ROLE_KEY=
